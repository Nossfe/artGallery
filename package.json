{
  "name": "art-gallery",
  "version": "0.1.0",
  "description": "Galería de pinturas con panel de administración y compra por WhatsApp",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,css \"nodemon server/index.js\" \"npm run watch:css\"",
    "build": "npm run build:css",
    "start": "node server/index.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "migrate": "node server/db/migrate.js",
    "seed:admin": "node server/db/seed-admin.js",
    "backup:db": "node server/db/backup.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.2.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "vitest": "^5.1.1"
  }
}
